# ========================================================================
# Core Settings - Single Source of Truth for All Bots
# ========================================================================
# This file defines all shared configuration used by JIT, Hedge, and Trend bots.
# Environment variables override YAML defaults for flexibility.

# ============================================================================
# RPC Configuration
# ============================================================================
# Primary RPC endpoint for blockchain communication
RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
RPC_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
RPC_COMMITMENT=confirmed

# ============================================================================
# Wallet Configuration
# ============================================================================
# Path to your keypair file (64-byte ed25519 keypair)
KEYPAIR_PATH=/secrets/wallet.json

# Optional: Taker authority for Swift orders (if different from wallet pubkey)
TAKER_AUTHORITY=

# ============================================================================
# Swift Integration
# ============================================================================
# Swift orders API endpoint
SWIFT_ORDERS_BASE=https://swift.drift.trade

# Request timeout for Swift API calls
SWIFT_TIMEOUT_SECONDS=30

# ============================================================================
# JITO Integration (Optional)
# ============================================================================
# Enable JITO for faster transaction landing
JITO_ENABLE=0
JITO_TIP=0

# ============================================================================
# Feature Flags
# ============================================================================
# Enable Crash v2 features
FEATURE_CRASH_V2=1

# Enable Cancel/Replace v2 features
FEATURE_CXLREP_V2=1

# Enable Order Book Intelligence
FEATURE_OBI=1

# ============================================================================
# Observability
# ============================================================================
# Prometheus metrics port
PROM_PORT=9090

# Logging level
LOG_LEVEL=INFO

# ============================================================================
# Network & Defaults
# ============================================================================
# Solana network to connect to
NETWORK=mainnet-beta

# Default markets available for trading
DEFAULT_MARKETS=SOL-PERP,BTC-PERP,ETH-PERP

# ============================================================================
# Bot-Specific Configuration
# ============================================================================
# Bot profiles are stored in configs/bots/ directory
# Each bot has its own YAML file with local settings:
# - JIT: configs/bots/jit.yaml
# - Hedge: configs/bots/hedge.yaml
# - Trend: configs/bots/trend.yaml

# ============================================================================
# Development Overrides
# ============================================================================
# For local development, override with:
# NETWORK=devnet
# RPC_HTTP=https://api.devnet.solana.com
# RPC_WS=wss://api.devnet.solana.com
# SWIFT_ORDERS_BASE=https://master.swift.drift.trade

# ============================================================================
# Security Notes
# ============================================================================
# 1. Never commit real API keys to version control
# 2. Use environment variables for sensitive values
# 3. Rotate API keys regularly
# 4. Use dedicated wallets for each environment (devnet/mainnet)
# 5. Backup wallet keypairs securely

# ============================================================================
# Monitoring & Alerts
# ============================================================================
# Set up alerts for:
# - Wallet balance below threshold
# - High transaction failure rates
# - Network connectivity issues
# - Large position size warnings
