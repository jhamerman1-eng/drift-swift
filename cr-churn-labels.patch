     def _within_oracle_band(self, price: float, band_bp: int) -> bool:
         """
         Return true if price is within ±band_bp of oracle mark.
         """
         try:
             oracle = self.oracle_price()
             if oracle is None or oracle <= 0:
                 return True
             bp = abs(price - oracle) / oracle * 1e4
             return bp <= band_bp
         except Exception:
             return True
