{
  "name": "@drift-bots/jit-maker",
  "version": "1.0.0",
  "description": "JIT Maker Service for Drift Protocol - Production Ready Implementation",
  "type": "module",
  "main": "dist/simple-index.js",
  "scripts": {
    "start": "node dist/simple-index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "health": "curl -s http://localhost:8787/health | jq",
    "metrics": "curl -s http://localhost:8787/metrics",
    "smoke-test": "curl -X POST http://localhost:8787/test/smoke -H 'Content-Type: application/json'"
  },
  "dependencies": {
    "@drift-labs/sdk": "^2.0.0",
    "@solana/web3.js": "^1.95.2",
    "bs58": "^6.0.0",
    "express": "^4.19.2",
    "pino": "^9.0.0",
    "pino-pretty": "^10.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "joi": "^17.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "drift",
    "jit",
    "maker",
    "solana",
    "defi",
    "trading"
  ],
  "author": "Drift Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drift-labs/drift-bots"
  }
}