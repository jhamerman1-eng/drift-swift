# JIT Maker Service Configuration Example
# Copy this file to .env and fill in your values

# Required: Solana RPC endpoint
RPC_URL=https://api.mainnet-beta.solana.com

# Required: Drift environment (mainnet-beta or devnet)
DRIFT_ENV=mainnet-beta

# Required: JIT Proxy Program ID
JIT_PROXY_PROGRAM_ID=J1TnP8zvVxbtF5KFp5xRmWuvG9McnhzmBd9XGfCyuxFP

# Required: Maker keypair as JSON array
# Example: [1,2,3,4,...] (64-byte array)
MAKER_KEYPAIR=[...]

# Optional: Market indexes to support (comma-separated)
# 0=SOL-PERP, 1=BTC-PERP, 2=ETH-PERP
MARKET_INDEXES=0,1,2

# Optional: Maximum slot skew for validation
SLOT_SKEW_MAX=30

# Optional: Server configuration
PORT=8787
HOST=0.0.0.0

# Optional: Request timeout in milliseconds
REQUEST_TIMEOUT_MS=5000

# Optional: Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=100

# Optional: Enable metrics collection
METRICS_ENABLED=true

# Optional: Log level
LOG_LEVEL=info

# Optional: Development mode (enables pretty logging)
NODE_ENV=production



